# FlowMind AI - Local Docker Compose Environment
# Copy to .env in root or relevant app and adjust. Never commit real secrets.

# Control plane (routing / licensing only — never sessions/events/SOPs)
CONTROL_DATABASE_URL=postgresql://flowmind:flowmind_dev@postgres-control:5432/flowmind_control
DATABASE_URL=postgresql://flowmind:flowmind_dev@postgres-control:5432/flowmind_control

# ---------------------------------------------------------------------------
# Gate 0.2 — Secret refs
# Control DB client_routes stores REFS only (e.g. db_connection_ref=client-a-db).
# Runtime resolves refs via env (or optional SECRET_REFS_JSON map).
# Host-run API against Docker DBs: use localhost:5433 instead of postgres-client-a.
# ---------------------------------------------------------------------------
CLIENT_DATABASE_URL=postgresql://client_a:client_a_dev@postgres-client-a:5432/client_a_db
# Resolves ClientRoute.db_connection_ref "client-a-db":
CLIENT_A_DATABASE_URL=postgresql://client_a:client_a_dev@postgres-client-a:5432/client_a_db
# Optional JSON map override: {"client-a-db":"postgresql://...","client-a-ai":"{...}"}
# SECRET_REFS_JSON=

# Redis
REDIS_URL=redis://redis:6379

# Object storage (MinIO local)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1

# Auth (Gate 0.4)
# Required outside NODE_ENV=development (fail-fast). Dev falls back only if unset.
JWT_SECRET=dev-super-secret-change-in-real-env
JWT_EXPIRES_IN=7d

# Dev helper: allow X-Client-Id header when not on a real client subdomain
ALLOW_DEV_CLIENT_HEADER=true

# API / ports
PORT=4000
WEB_PORT=3000

# AI — keys live in env only (never in client_routes.ai_config_ref).
# Ref "client-a-ai" resolves via CLIENT_A_AI_CONFIG JSON, else shared AI_* below.
# CLIENT_A_AI_CONFIG={"provider":"stub","model":"stub"}
AI_PROVIDER=stub
# AI_MODEL=grok-beta
# XAI_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=
# Do not enable real AI calls until after timeline + processing is solid.

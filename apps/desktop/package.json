{
  "name": "flowmind-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "electron .",
    "predev": "npm run build",
    "dev": "tsc -p tsconfig.json -w & electron .",
    "package": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test dist-test/recording-ui.spec.js",
    "test:cov": "npm test"
  },
  "dependencies": {
    "electron": "^31.7.7"
  },
  "optionalDependencies": {
    "active-win": "^8.2.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "ai.flowmind.desktop",
    "productName": "FlowMind Recorder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "extraMetadata": {
      "main": "dist/main.js"
    }
  }
}
